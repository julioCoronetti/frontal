#!/usr/bin/env bash
set -euo pipefail

changed_count=$(git diff --cached --name-only --diff-filter=ACMRT | wc -l)
if [[ $changed_count -gt 5 && "${ATOMIC_OVERRIDE:-0}" != "1" ]]; then
  echo "Error: Atomic commit threshold exceeded ($changed_count files staged, max 5 allowed)." >&2
  echo "Decompose your changes into smaller atomic commits, or set ATOMIC_OVERRIDE=1 for structural refactors." >&2
  exit 1
fi

./scripts/verify.sh
